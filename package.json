{
  "name": "unplugin-ts-mock",
  "version": "0.1.9",
  "description": "Build-time TypeScript type → faker mock generator for Vite, Rollup, webpack, and esbuild",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./rollup": {
      "types": "./dist/rollup/index.d.ts",
      "import": "./dist/rollup/index.js",
      "require": "./dist/rollup/index.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack/index.d.ts",
      "import": "./dist/webpack/index.js",
      "require": "./dist/webpack/index.cjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild/index.d.ts",
      "import": "./dist/esbuild/index.js",
      "require": "./dist/esbuild/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "esbuild": ">=0.18.0",
    "rollup": ">=3.0.0",
    "vite": ">=4.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.0",
    "typescript": "^5.3.0",
    "unplugin": "^1.0.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "vitest": "^4.1.7"
  }
}
